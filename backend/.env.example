NODE_ENV=development
PORT=3000

# Neon PostgreSQL connection strings
# DATABASE_URL: Pooled connection string for application runtime (Neon PgBouncer pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/capacity_connect?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct connection string for schema migrations and administrative operations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/capacity_connect?sslmode=require"

# JWT configuration
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your_refresh_token_super_secret_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Argon2id password hashing parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Cloudflare Turnstile CAPTCHA (Using Cloudflare's always-pass testing keys by default)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_BYPASS_DEV=false

# Allowed official IMD email domains (comma-separated)
IMD_ALLOWED_EMAIL_DOMAINS=imd.gov.in,moes.gov.in

# SMTP configuration for verification and password reset emails
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="Capacity Connect <noreply@imd.gov.in>"

# Application URLs & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cookies
COOKIE_DOMAIN=localhost
