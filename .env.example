# Project Root Environment Variables Template

# ==========================================
# 1. APPLICATION & NETWORK CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000/api/v1
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# ==========================================
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# ==========================================
# Pooled connection string for regular queries (Neon PgBouncer)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/capacity_connect?sslmode=require&pgbouncer=true"
# Direct connection string for schema migrations and admin operations
DIRECT_URL="postgresql://neondb_owner:your_password@ep-sample.us-east-2.aws.neon.tech/capacity_connect?sslmode=require"

# ==========================================
# 3. AI & INTELLIGENCE INTEGRATION (Gemini API)
# ==========================================
# Google Gemini API key for assistant chatbot, content summarization & assessments
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ==========================================
# 4. SECURITY & AUTHENTICATION
# ==========================================
JWT_ACCESS_SECRET=super_secret_jwt_access_key_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_min_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Argon2id password hashing parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Cloudflare Turnstile CAPTCHA (always-pass dummy keys for development)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_BYPASS_DEV=false

# Allowed official email domains for registration
IMD_ALLOWED_EMAIL_DOMAINS=imd.gov.in,moes.gov.in

# ==========================================
# 5. INSTITUTIONAL SMTP (EMAIL DISPATCH)
# ==========================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="Capacity Connect <noreply@imd.gov.in>"
